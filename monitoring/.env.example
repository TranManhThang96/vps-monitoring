# Copy to .env and fill in. See README.md. `make init` does this and generates the secrets it can.

# External docker network created by ../infra (`make network`).
SHARED_NETWORK=shared-net
# Host interface for Prometheus (9090) and Grafana (4000). 127.0.0.1 = reachable only
# from the VPS itself (SSH tunnel, or nginx with TLS in front). 0.0.0.0 exposes them publicly.
BIND_ADDR=127.0.0.1
# What host.docker.internal resolves to inside containers: the docker0 address
# (`ip -4 addr show docker0`). node-exporter listens only on this address.
HOST_GATEWAY_IP=172.17.0.1

# --- Grafana ---
# Login: user admin. Generated by `make init`. Grafana applies it only when it creates
# an empty grafana-data volume; for an existing volume see README.md.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Native MySQL on the VPS (mysqld-exporter) ---
# host.docker.internal = the VPS, reached through the docker0 address.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=exporter
MYSQL_PASSWORD=CHANGE_ME

# --- PostgreSQL in ../infra (postgres-exporter) ---
# Run `make pg-monitor-user` in ../infra; it prints this password once.
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME

# --- Redis in ../infra (redis-exporter) ---
# Same value as REDIS_PASSWORD in ../infra/.env (`make init` copies it).
REDIS_PASSWORD=CHANGE_ME

# --- Image versions (pinned; bump on purpose, then `make pull && make up`) ---
PROMETHEUS_VERSION=v3.16.0
GRAFANA_VERSION=13.3.0
NODE_EXPORTER_VERSION=v1.12.1
MYSQLD_EXPORTER_VERSION=v0.21.0
NGINX_EXPORTER_VERSION=1.5.3
POSTGRES_EXPORTER_VERSION=v0.20.1
REDIS_EXPORTER_VERSION=v1.97.0

# --- Limits ---
# Prometheus drops the oldest blocks once the data passes this size (or 200h, whichever first).
PROMETHEUS_RETENTION_SIZE=5GB
PROMETHEUS_MEM_LIMIT=1g
GRAFANA_MEM_LIMIT=512m
