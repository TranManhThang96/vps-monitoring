# Copied to .env by `make init`, which replaces every `change-me` below with a
# random secret. Edit the domains (and versions if needed) before `make up`.

# ── Shared ────────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
DATA_DIR=./data
BIND_ADDR=127.0.0.1
SHARED_NETWORK=shared-net
# Fixed subnet of agent-net. PROXY_IP is its gateway: the address the host
# nginx appears as to the containers. Change both together or not at all.
AGENT_SUBNET=192.168.32.0/24
PROXY_IP=192.168.32.1

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.47.7
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_HOST_PORT=5678
# 2 = nginx + Cloudflare proxy, 1 = nginx only (Cloudflare DNS-only).
N8N_PROXY_HOPS=2
N8N_ENCRYPTION_KEY=change-me
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me
N8N_MEM_LIMIT=2g

# ── OpenClaw ──────────────────────────────────────────────────────────────────
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.11.3
OPENCLAW_HOST=claw.example.com
OPENCLAW_HOST_PORT=18789
OPENCLAW_GATEWAY_TOKEN=change-me
OPENCLAW_MEM_LIMIT=3g

# ── Hermes ────────────────────────────────────────────────────────────────────
HERMES_IMAGE=nousresearch/hermes-agent:v0.23.1
# Host uid/gid that owns data/hermes; the image remaps its internal user.
HERMES_UID=1000
HERMES_GID=1000
HERMES_HOST=hermes.example.com
HERMES_DASHBOARD_HOST_PORT=9119
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=change-me
# Signs dashboard sessions; rotating it logs everyone out.
HERMES_DASHBOARD_SECRET=change-me
# Hermes always runs its OpenAI-compatible API server on 8642 (the image
# generates API_SERVER_KEY into data/hermes/.env on first boot); the port is
# published on loopback only. Nothing proxies it unless you add a vhost.
HERMES_API_HOST_PORT=8642
HERMES_MEM_LIMIT=4g
