SERVICES := n8n openclaw hermes

# .env holds generated hex secrets only (foundation of the Makefile defaults).
-include .env
SHARED_NETWORK ?= shared-net
DATA_DIR       ?= ./data
# The superuser of the shared Postgres belongs to ../infra/.env, not this file.
PG_USER        := $(or $(shell sed -n 's/^POSTGRES_USER=//p' ../infra/.env 2>/dev/null),postgres)

# Optional: limit a target to one platform, e.g. `make up SVC=hermes`.
SVC ?=
# Payload for `make openclaw-cli CMD="devices list"` / `make hermes-cli CMD="--help"`.
CMD ?=

COMPOSE := docker compose
PG      := docker exec shared-postgres psql -v ON_ERROR_STOP=1 -U $(PG_USER)

# Platform name -> compose service. OpenClaw's service keeps the upstream name.
SERVICE_n8n      := n8n
SERVICE_openclaw := openclaw-gateway
SERVICE_hermes   := hermes
svc = $(or $(SERVICE_$(1)),$(1))

# Reverse-proxy + token config applied to OpenClaw. Shared by openclaw-init and openclaw-conf.
OPENCLAW_BATCH = '[{"path":"gateway.controlUi.allowedOrigins","value":["https://$(OPENCLAW_HOST)"]},{"path":"gateway.trustedProxies","value":["$(PROXY_IP)"]},{"path":"gateway.auth.mode","value":"token"},{"path":"gateway.auth.token","value":{"source":"env","provider":"default","id":"OPENCLAW_GATEWAY_TOKEN"}}]'

.DEFAULT_GOAL := help
.PHONY: help init network up up-all down down-all restart ps logs pull config urls \
        n8n-db openclaw-init openclaw-conf openclaw-cli hermes-setup hermes-cli shell \
        $(addprefix up-,$(SERVICES)) $(addprefix down-,$(SERVICES)) \
        $(addprefix restart-,$(SERVICES)) $(addprefix logs-,$(SERVICES))

help:
	@echo "Platforms: $(SERVICES)  (plus one-off service: openclaw-cli)"
	@echo ""
	@echo "  make init                 create .env with random secrets, data dirs, and network"
	@echo "  make n8n-db               create the n8n role + database in shared-postgres"
	@echo "  make openclaw-init        onboarding + reverse-proxy config (run before first up)"
	@echo "  make openclaw-conf        re-apply reverse-proxy config to a running gateway"
	@echo "  make hermes-setup         interactive Hermes setup wizard (run before first up)"
	@echo "  make up                   start all platforms   (make up SVC=hermes for one)"
	@echo "  make up-all | down-all    same as up / down"
	@echo "  make down                 stop + remove all containers (data is kept)"
	@echo "  make restart              restart all          (SVC=... for one)"
	@echo "  make up-<svc> | down-<svc> | restart-<svc> | logs-<svc>"
	@echo "  make ps | logs | pull | config | urls"
	@echo "  make openclaw-cli CMD=... run an OpenClaw CLI command (devices list, channels add, ...)"
	@echo "  make hermes-cli CMD=...   run a Hermes CLI command (e.g. CMD=\"doctor\")"
	@echo "  make shell SVC=hermes     shell inside a container"

# Creates .env from .env.example and replaces every `change-me` with a secret.
# Refuses to overwrite an existing .env: that file holds N8N_ENCRYPTION_KEY.
init:
	@test ! -f .env || { echo ".env already exists, not overwriting"; exit 1; }
	@cp .env.example .env
	@set -e; \
	sed -i \
	  -e "s|^N8N_ENCRYPTION_KEY=.*|N8N_ENCRYPTION_KEY=$$(openssl rand -hex 32)|" \
	  -e "s|^N8N_DB_PASSWORD=.*|N8N_DB_PASSWORD=$$(openssl rand -hex 16)|" \
	  -e "s|^OPENCLAW_GATEWAY_TOKEN=.*|OPENCLAW_GATEWAY_TOKEN=$$(openssl rand -hex 32)|" \
	  -e "s|^HERMES_DASHBOARD_PASSWORD=.*|HERMES_DASHBOARD_PASSWORD=$$(openssl rand -hex 16)|" \
	  -e "s|^HERMES_DASHBOARD_SECRET=.*|HERMES_DASHBOARD_SECRET=$$(openssl rand -hex 32)|" \
	  .env
	@chmod 600 .env
	@mkdir -p $(DATA_DIR)/n8n $(DATA_DIR)/openclaw \
	          $(DATA_DIR)/openclaw-auth-profile-secrets $(DATA_DIR)/hermes
	@# n8n and OpenClaw run as uid/gid 1000 (node). Hermes owns /opt/data itself.
	@chown -R 1000:1000 $(DATA_DIR)/n8n $(DATA_DIR)/openclaw \
	          $(DATA_DIR)/openclaw-auth-profile-secrets $(DATA_DIR)/hermes 2>/dev/null \
	  || echo "chown to uid 1000 failed: run 'sudo chown -R 1000:1000 $(DATA_DIR)/n8n $(DATA_DIR)/openclaw $(DATA_DIR)/openclaw-auth-profile-secrets $(DATA_DIR)/hermes'"
	@echo ".env created with random secrets. Set N8N_HOST, OPENCLAW_HOST, HERMES_HOST, N8N_WEBHOOK_URL."
	@echo "Dashboard password: grep HERMES_DASHBOARD_PASSWORD .env"

network:
	@docker network inspect $(SHARED_NETWORK) >/dev/null 2>&1 \
	  || docker network create $(SHARED_NETWORK)

# Creates the n8n login role and its database. Idempotent: safe to rerun.
n8n-db:
	@test -f .env || { echo ".env missing, run 'make init' first"; exit 1; }
	@printf '%s' "$(N8N_DB_USER)" | grep -Eq '^[a-z_][a-z0-9_]*$$' \
	  || { echo "N8N_DB_USER must match [a-z_][a-z0-9_]*"; exit 1; }
	@printf '%s' "$(N8N_DB_NAME)" | grep -Eq '^[a-z_][a-z0-9_]*$$' \
	  || { echo "N8N_DB_NAME must match [a-z_][a-z0-9_]*"; exit 1; }
	@printf '%s' "$(N8N_DB_PASSWORD)" | grep -Eq '^[A-Za-z0-9._~-]+$$' \
	  || { echo "N8N_DB_PASSWORD must be alphanumeric (it is generated by 'make init')"; exit 1; }
	@docker inspect shared-postgres >/dev/null 2>&1 \
	  || { echo "shared-postgres is not running: cd ../infra && make up"; exit 1; }
	@set -e; \
	role=$$($(PG) -tAc "SELECT 1 FROM pg_roles WHERE rolname='$(N8N_DB_USER)'"); \
	if [ -z "$$role" ]; then \
	  $(PG) -d postgres -c "CREATE ROLE \"$(N8N_DB_USER)\" LOGIN PASSWORD '$(N8N_DB_PASSWORD)'"; \
	else echo "role $(N8N_DB_USER) already exists"; fi; \
	db=$$($(PG) -tAc "SELECT 1 FROM pg_database WHERE datname='$(N8N_DB_NAME)'"); \
	if [ -z "$$db" ]; then \
	  $(PG) -d postgres -c "CREATE DATABASE \"$(N8N_DB_NAME)\" OWNER \"$(N8N_DB_USER)\""; \
	else echo "database $(N8N_DB_NAME) already exists"; fi

# Interactive onboarding writes openclaw.json; the config set then teaches the
# gateway that it sits behind the host nginx (trusted proxy + browser origin).
# Run with the gateway stopped: onboarding takes exclusive ownership of the state.
openclaw-init:
	@test -f .env || { echo ".env missing, run 'make init' first"; exit 1; }
	$(COMPOSE) run --rm --no-deps --entrypoint node openclaw-gateway \
	  dist/index.js onboard --mode local --no-install-daemon --tui
	$(COMPOSE) run --rm --no-deps --entrypoint node openclaw-gateway \
	  dist/index.js config set --batch-json $(OPENCLAW_BATCH)
	@echo "Config written: allowedOrigins=https://$(OPENCLAW_HOST) trustedProxies=$(PROXY_IP), auth token = env ref OPENCLAW_GATEWAY_TOKEN"

# Re-applies the reverse-proxy config to a running gateway (no onboarding, no
# ownership wait). Use after changing OPENCLAW_HOST/PROXY_IP, then restart.
openclaw-conf:
	@test -f .env || { echo ".env missing, run 'make init' first"; exit 1; }
	$(COMPOSE) exec -T openclaw-gateway node dist/index.js config set --batch-json $(OPENCLAW_BATCH)
	$(COMPOSE) restart openclaw-gateway

openclaw-cli:
	@test -n "$(CMD)" || { echo "usage: make openclaw-cli CMD=\"devices list\""; exit 1; }
	$(COMPOSE) run --rm openclaw-cli $(CMD)

hermes-setup:
	@test -f .env || { echo ".env missing, run 'make init' first"; exit 1; }
	$(COMPOSE) run --rm hermes setup

hermes-cli:
	@test -n "$(CMD)" || { echo "usage: make hermes-cli CMD=\"doctor\""; exit 1; }
	$(COMPOSE) exec hermes hermes $(CMD)

shell:
	@test -n "$(SVC)" || { echo "usage: make shell SVC=hermes"; exit 1; }
	$(COMPOSE) exec $(call svc,$(SVC)) sh

up: network
	$(COMPOSE) up -d $(call svc,$(SVC))

up-all: up

# `down` with SVC removes only that container; without, all of them.
# Neither form deletes ./data. agent-net is recreated by the next `up`.
down:
ifeq ($(SVC),)
	$(COMPOSE) down
else
	$(COMPOSE) rm -sf $(call svc,$(SVC))
endif

down-all: down

restart: network
	$(COMPOSE) restart $(call svc,$(SVC))

ps:
	$(COMPOSE) ps

logs:
	$(COMPOSE) logs -f --tail=100 $(call svc,$(SVC))

pull:
	$(COMPOSE) pull $(call svc,$(SVC))

config:
	$(COMPOSE) config

urls:
	@echo "n8n     https://$(N8N_HOST)        local http://$(BIND_ADDR):$(N8N_HOST_PORT)"
	@echo "OpenClaw https://$(OPENCLAW_HOST) local http://$(BIND_ADDR):$(OPENCLAW_HOST_PORT)"
	@echo "Hermes  https://$(HERMES_HOST)    local http://$(BIND_ADDR):$(HERMES_DASHBOARD_HOST_PORT)"

$(addprefix up-,$(SERVICES)): up-%:
	@$(MAKE) --no-print-directory up SVC=$*
$(addprefix down-,$(SERVICES)): down-%:
	@$(MAKE) --no-print-directory down SVC=$*
$(addprefix restart-,$(SERVICES)): restart-%:
	@$(MAKE) --no-print-directory restart SVC=$*
$(addprefix logs-,$(SERVICES)): logs-%:
	@$(MAKE) --no-print-directory logs SVC=$*
