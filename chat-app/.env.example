# Copied to .env by `make init`, which replaces every `change-me` below with a
# random secret. Edit the domain and the API key before `make up`.

# ── Shared ────────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
DATA_DIR=./data
BIND_ADDR=127.0.0.1
# External network owned by ../infra; the vector DB is reached through it.
SHARED_NETWORK=shared-net
WEBUI_URL=https://chat.example.com
OPEN_WEBUI_HOST_PORT=3080
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.3
OPEN_WEBUI_MEM_LIMIT=2g
# false: Open WebUI may download the RAG embedding model once (~90 MB, then it
# lives in data/cache). true: fully offline, but document upload stops working.
OFFLINE_MODE=false

# ── Open WebUI accounts ───────────────────────────────────────────────────────
# Generated by `make init`; rotate WEBUI_SECRET_KEY only by also exporting the
# config, since stored MCP/OAuth tokens get encrypted with it.
WEBUI_SECRET_KEY=change-me
# Created on first start (fresh database only). Sign-up is disabled by the
# compose file, so this is the only way in.
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change-me
# pending: new users wait for admin approval. user: auto-activated.
DEFAULT_USER_ROLE=pending

# ── Model provider: Command Code ──────────────────────────────────────────────
# OpenAI-compatible surface of Command Code; /models and /chat/completions live
# under this base. Key format: user_...
OPENAI_API_BASE_URL=https://api.commandcode.ai/provider/v1
OPENAI_API_KEY=change-me
# Pin the model picker to this deployment's only model. Key "0" is the first
# entry of OPENAI_API_BASE_URL. Drop model_ids to expose all 98 served models.
OPENAI_API_CONFIGS={"0": {"enable": true, "model_ids": ["deepseek/deepseek-v4.1-flash"]}}

# ── Vector store: shared Postgres (pgvector) ──────────────────────────────────
# Run `make db` once to create this role/database and enable the extension.
# DB_PASSWORD is generated by `make db` when it is still `change-me`.
SHARED_POSTGRES_HOST=shared-postgres
DB_NAME=openwebui
DB_USER=openwebui
DB_PASSWORD=change-me
# Vector width; must match the embedding model and cannot change after the first
# indexed document. 384 = sentence-transformers/all-MiniLM-L6-v2 (default).
PGVECTOR_DIM=384
# ANN index for document_chunk. Leave empty: below 5000 chunks pgvector does an
# exact scan (best recall, no maintenance), and Open WebUI's default ivfflat is
# only built past that point. Set hnsw for large corpora; switching later needs
# `DROP INDEX idx_document_chunk_vector`.
#PGVECTOR_INDEX_METHOD=hnsw
