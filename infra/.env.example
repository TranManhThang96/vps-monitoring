# Copy to .env (or run `make init` to generate secrets automatically).

# --- Shared ---
# External docker network that other apps join. Created by `make network`.
SHARED_NETWORK=shared-net
# Host interface for published ports. 127.0.0.1 = reachable only from the VPS
# itself (native nginx/PHP). Use 0.0.0.0 to expose publicly (not recommended).
BIND_ADDR=127.0.0.1
# Where persistent data is stored on the host.
DATA_DIR=./data

# --- PostgreSQL ---
# Changing the major version needs a dump/restore or pg_upgrade; do not just bump it.
POSTGRES_VERSION=17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_MEM_LIMIT=3g

# --- Redis ---
REDIS_VERSION=7
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
# noeviction: writes fail when full (safe for queues/sessions).
# allkeys-lru: evict old keys (cache-only use).
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_MEM_LIMIT=768m

# --- Garage (S3-compatible object storage; MinIO community edition is archived) ---
GARAGE_VERSION=v2.5.0
# S3 endpoint: http://127.0.0.1:GARAGE_S3_PORT  region: garage  path-style addressing
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
# Access key must look like GK + 32 hex chars; secret key is 64 hex chars.
GARAGE_ACCESS_KEY=CHANGE_ME
GARAGE_SECRET_KEY=CHANGE_ME
# Created on first start. More buckets: `make garage-bucket NAME=photos`.
GARAGE_BUCKET=default-bucket
# 32-byte hex (openssl rand -hex 32). Do not change after first start.
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
# Bearer token for /metrics on the admin port. Prometheus (../monitoring) reads
# it from monitoring/secrets/garage_metrics_token.
GARAGE_METRICS_TOKEN=CHANGE_ME
GARAGE_MEM_LIMIT=1g
# Web UI (khairul169/garage-webui). Login is `user:bcrypt-hash` with every `$` written as `$$`.
# Generate with `make garage-webui-auth` (prints the password once).
GARAGE_WEBUI_VERSION=1.1.0
GARAGE_WEBUI_PORT=3909
GARAGE_WEBUI_AUTH=
GARAGE_WEBUI_MEM_LIMIT=128m

# Postgres /dev/shm size (Docker's default is 64 MB).
POSTGRES_SHM_SIZE=256m
